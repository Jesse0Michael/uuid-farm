{
  "name": "uuid-farm-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api-types.ts",
    "docs": "redocly build-docs ../api/openapi.yaml --config ../redocly.yaml --template ../docs/template.hbs --inlineBundle --output ../docs/index.html",
    "lint:api": "redocly lint ../api/openapi.yaml --config ../redocly.yaml",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@redocly/cli": "2.78.0",
    "@types/node": "^24.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
